{
    "name": "captur/events",
    "description": "PHP SDK for the captur.events API",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "captur",
        "events",
        "sdk",
        "api"
    ],
    "homepage": "https://captur.events",
    "autoload": {
        "psr-4": {
            "Captur\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Stuart Todd"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.12",
        "rector/rector": "^1.2",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-drift": "^3.0"
    },
    "scripts": {
        "tests": "./vendor/bin/pest",
        "test:coverage": "./vendor/bin/pest --coverage --min=100",
        "phpcs": "./vendor/bin/phpcs --standard=PSR12 --report=summary src/",
        "phpcbf": "./vendor/bin/phpcbf --standard=PSR12 src/",
        "phpmd": "./vendor/bin/phpmd src/ text cleancode,codesize,controversial,design,naming,unusedcode",
        "phpstan": "./vendor/bin/phpstan analyse src/ --level max",
        "rector:dry-run": "./vendor/bin/rector process --dry-run",
        "rector": "./vendor/bin/rector process",
        "standards:check": [
            "@phpcs",
            "@phpmd",
            "@phpstan",
            "@rector:dry-run"
        ],
        "standards:fix": [
            "@phpcbf",
            "@rector"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
